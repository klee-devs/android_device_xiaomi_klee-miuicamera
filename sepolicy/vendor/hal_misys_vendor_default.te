# /vendor/bin/hypsys_vendor, serves IMiSysImpl, IHypSysIntl and IMtkblackboxImpl

type hal_misys_vendor_default, domain;
type hal_misys_vendor_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_misys_vendor_default)
binder_use(hal_misys_vendor_default)

hal_server_domain(hal_misys_vendor_default, hal_misys_vendor)
hal_client_domain(hal_misys_vendor_default, hal_misyscore)

allow hal_misys_vendor_default mnt_vendor_file:dir create_dir_perms;
allow hal_misys_vendor_default mnt_vendor_file:file create_file_perms;
allow hal_misys_vendor_default vendor_data_file:dir create_dir_perms;
allow hal_misys_vendor_default vendor_data_file:file create_file_perms;
allow hal_misys_vendor_default kmsg_device:chr_file rw_file_perms;
allow hal_misys_vendor_default self:capability2 block_suspend;

get_prop(hal_misys_vendor_default, vendor_default_prop)
get_prop(hal_misys_vendor_default, boot_status_prop)

# ChargerLogger: charger, fuel gauge and thermal state, plus the Xiaomi
# charge log ring buffer, and the power_supply uevents it listens to.
r_dir_file(hal_misys_vendor_default, sysfs_batteryinfo)
r_dir_file(hal_misys_vendor_default, sysfs_therm)
allow hal_misys_vendor_default vendor_sysfs_xm_charge_log:dir r_dir_perms;
allow hal_misys_vendor_default vendor_sysfs_xm_charge_log:file rw_file_perms;
allow hal_misys_vendor_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# MiuiCamera hands frames to IMiSysImpl through ashmem file descriptors.
# miuicamera_app is system_ext private, so match it through appdomain.
allow hal_misys_vendor_default appdomain:fd use;
allow hal_misys_vendor_default appdomain_tmpfs:file { read getattr map };

# MiuiCamera: LUTs and the permission test file in /mnt/vendor/persist/camera
allow hal_misys_vendor_default persist_data_file:dir create_dir_perms;
allow hal_misys_vendor_default persist_data_file:file create_file_perms;

# MiuiCamera: watermark folders and files in /data/vendor/camera
allow hal_misys_vendor_default vendor_camera_data_file:dir create_dir_perms;
allow hal_misys_vendor_default vendor_camera_data_file:file create_file_perms;

# MtkDfd, ModuleManager and MtkDump probe block devices, not needed to operate
dontaudit hal_misys_vendor_default { block_device expdb_block_device }:blk_file getattr;
