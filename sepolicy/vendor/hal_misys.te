# Xiaomi misys / HypSys HALs, used by MiuiCamera and idmanager

attribute hal_misys_vendor;
attribute hal_misys_vendor_client;
attribute hal_misys_vendor_server;

attribute hal_misyscore;
attribute hal_misyscore_client;
attribute hal_misyscore_server;

type hal_misys_vendor_service, protected_service, service_manager_type, hal_service_type;
type hal_misyscore_service, protected_service, service_manager_type, hal_service_type;

binder_call(hal_misys_vendor_client, hal_misys_vendor_server)
binder_call(hal_misys_vendor_server, hal_misys_vendor_client)
hal_attribute_service(hal_misys_vendor, hal_misys_vendor_service)

binder_call(hal_misyscore_client, hal_misyscore_server)
binder_call(hal_misyscore_server, hal_misyscore_client)
hal_attribute_service(hal_misyscore, hal_misyscore_service)

# Clients, as on the stock vendor policy
hal_client_domain(platform_app, hal_misys_vendor)
hal_client_domain(system_app, hal_misys_vendor)
hal_client_domain(system_server, hal_misys_vendor)
hal_client_domain(hal_idmanager_default, hal_misyscore)
