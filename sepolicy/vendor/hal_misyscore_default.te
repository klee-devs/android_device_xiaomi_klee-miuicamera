# /vendor/bin/hw/vendor.xiaomi.hardware.misys.core-service, serves IMiSysCore

type hal_misyscore_default, domain;
type hal_misyscore_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_misyscore_default)
binder_use(hal_misyscore_default)

hal_server_domain(hal_misyscore_default, hal_misyscore)

allow hal_misyscore_default mnt_vendor_file:dir create_dir_perms;
allow hal_misyscore_default mnt_vendor_file:file create_file_perms;
allow hal_misyscore_default vendor_data_file:dir create_dir_perms;
allow hal_misyscore_default vendor_data_file:file create_file_perms;

get_prop(hal_misyscore_default, vendor_default_prop)
